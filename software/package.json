{
  "name": "@platforma-open/milaboratories.functional-analysis.software",
  "version": "2.3.7",
  "description": "Block Software: Run Pathway Enrichment with R",
  "files": [
    "./dist/**/*"
  ],
  "type": "module",
  "scripts": {
    "build": "block-tools software build",
    "test": "true",
    "do-pack": "shx rm -f *.tgz && block-tools software build && pnpm pack && shx mv platforma-open*.tgz package.tgz",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@platforma-open/milaboratories.runenv-python-3": "catalog:",
    "@platforma-open/milaboratories.runenv-r-functional-analysis": "catalog:",
    "@platforma-sdk/block-tools": "catalog:"
  },
  "block-software": {
    "entrypoints": {
      "over-representation-analysis": {
        "binary": {
          "artifact": {
            "type": "R",
            "registry": "platforma-open",
            "environment": "@platforma-open/milaboratories.runenv-r-functional-analysis:main",
            "root": "./src/over-representation-analysis"
          },
          "cmd": [
            "Rscript",
            "{pkg}/over_representation_analysis.R"
          ]
        },
        "docker": {
          "artifact": {
            "type": "docker",
            "context": "./src/over-representation-analysis",
            "dockerfile": "Dockerfile"
          },
          "cmd": [
            "/app/over_representation_analysis.R"
          ]
        }
      }
    }
  }
}
